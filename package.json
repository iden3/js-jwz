{
  "name": "@iden3/js-jwz",
  "version": "1.14.0",
  "description": "JS implementation of JWZ",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "node": {
        "import": "./dist/node/esm/index.js",
        "require": "./dist/node/cjs/index.cjs"
      },
      "browser": "./dist/browser/esm/index.js",
      "umd": "./dist/browser/umd/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "type": "module",
  "sideEffects": false,
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:node && npm run build:browser && npm run build:types",
    "build:node": "node ./scripts/node.js",
    "build:types": "tsc --declaration --emitDeclarationOnly",
    "build:esm": "tsc --outDir dist/node/esm  --declaration --declarationDir dist/types",
    "build:browser": "rollup -c scripts/browser.mjs",
    "clean": "rimraf ./dist",
    "test": "vitest run",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint": "biome ci . && cspell \"**/*.{ts,js,mjs}\" --no-progress"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iden3/js-jwz.git"
  },
  "author": "iden3",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/iden3/js-jwz/issues"
  },
  "homepage": "https://github.com/iden3/js-jwz#readme",
  "browserslist": {
    "production": [
      "chrome >= 67",
      "edge >= 79",
      "firefox >= 68",
      "opera >= 54",
      "safari >= 14"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "peerDependencies": {
    "@noble/curves": "2.2.0",
    "@iden3/js-crypto": "1.3.3",
    "@iden3/js-iden3-core": "1.8.1",
    "@iden3/js-merkletree": "1.5.2",
    "ffjavascript": "https://github.com/iden3/ffjavascript#feat/esm-migration",
    "rfc4648": "1.5.4",
    "snarkjs": "https://github.com/iden3/snarkjs#feat/esm-migration"
  },
  "devDependencies": {
    "@iden3/biome-config": "https://github.com/iden3/eslint-config#biome-config",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@rollup/plugin-json": "6.1.0",
    "@types/node": "25.9.3",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "esbuild": "0.28.1",
    "playwright": "1.60.0",
    "rimraf": "6.1.3",
    "rollup": "4.62.0",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
